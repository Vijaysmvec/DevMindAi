# ==============================================================================
# DEVMIND AI — SINGULARITY: EXTREME
# Safe Environment Template (.env.example)
# Copy to .env (never commit real secrets to Git!)
# ==============================================================================

# 1. Runtime Environment: development | testing | staging | production
APP_ENV=development
DEBUG=false

# 2. Gemini AI Configuration (Server-Side Only — never prefix with VITE_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 3. Database Configuration
# Local dev default (when unset): async SQLite
# Production (required): Encrypted PostgreSQL + pgvector (e.g., Supabase PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://app_user:STRONG_PASSWORD@db.project.supabase.co:5432/postgres?ssl=require
DATABASE_URL=

# 4. Session Signing Secret (Required >= 32 random chars in staging/production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# 5. Network & Strict CORS Origins
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 6. Firebase Google Authentication — Backend Admin Verification (Server-Side Only)
FIREBASE_PROJECT_ID=
# Optional JSON string or file path for revocation checks (never expose to frontend!):
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# 7. Firebase Web SDK — Frontend Google Sign-In (Safe Public Identifiers Only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 8. Optional Shared Rate-Limit Storage (Recommended for multi-instance production)
REDIS_URL=

# 9. Optional Bootstrap Admin Identity (Server-Side Only)
INITIAL_ADMIN_EMAIL=
